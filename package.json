{
  "name": "spot-in",
  "version": "0.1.0",
  "private": true,
  "description": "Spot-In — marketplace connecting event organizers with malls and venue owners (course pilot, PRD v1.2)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/migrate.ts --reset",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:perf": "tsx scripts/seed-perf.ts",
    "jobs:tick": "tsx scripts/tick.ts",
    "pii-scan": "tsx scripts/pii-scan.ts",
    "perf:search": "tsx scripts/perf-search.ts",
    "pilot:delete": "tsx scripts/pilot-delete.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "leaflet": "^1.9.4",
    "next": "^16.4.5",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.3.1",
    "otplib": "^13.6.0",
    "postgres": "^4.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  }
}
