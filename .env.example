# --- Environment -----------------------------------------------------------
# APP_ENV: development | test | demo | pilot. The demo clock (FR-M38-10) exists only in "demo".
APP_ENV=development
# Pilot mode must stay on for the whole MVP (FR-M38-*). The server refuses to start without it.
PILOT_MODE=on
# Who may sign up (FR-M38-02, amended): invite = only emails on the Admin's invite list (default);
# open = anyone can sign up as an organizer or venue user. Pilot safeguards stay on either way.
# With open: use EMAIL_DRIVER=smtp (users must verify their email) and see docs/ops/public-launch.md.
REGISTRATION_MODE=invite
APP_URL=http://localhost:3000
# 32+ random bytes, used to sign cookies and signed file URLs
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Database (PostgreSQL 16 + PostGIS + pg_trgm + btree_gist) --------------
DATABASE_URL=postgres://spotin@127.0.0.1:5433/spotin
# Hosted (Supabase): use the *session pooler* or direct connection string and add ?sslmode=require
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Never commit the real value; set it in the host's secret store. See docs/ops/database.md.
# DB_PREPARE=false   # only if you use the transaction pooler (port 6543)
# DB_POOL_MAX=10

# --- Email (FR-M21-01). EMAIL_DRIVER=outbox stores mail in the database (dev/test);
# smtp sends it through the transactional provider.
EMAIL_DRIVER=outbox
EMAIL_FROM="Spot-In <no-reply@spot-in.test>"
SMTP_URL=
ADMIN_EMAILS=admin@spot-in.test

# --- File storage: local (dev/test) or s3 --------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# --- Virus scanning: eicar (dev/test signature check) or clamd ---------------
SCANNER_DRIVER=eicar
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# --- Geocoding: nominatim or fake (tests) --------------------------------------
GEOCODER_DRIVER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="Spot-In course pilot (contact: team email)"
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="© OpenStreetMap contributors"

# --- Google sign-in (optional; leave blank to hide the button) -----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Scheduled jobs on a serverless host (Vercel Cron) ------------------------
# The in-process 30 s ticker only runs on a long-lived Node server. On Vercel, vercel.json
# calls GET /api/cron/tick; Vercel sends CRON_SECRET as the bearer token when it is set.
CRON_SECRET=
# DISABLE_JOB_TICKER=1   # set on serverless hosts, where the in-process ticker cannot run

# --- Payments (Build 2). Only test-mode keys are accepted (FR-M14-13). ----------
XENDIT_SECRET_KEY=

# --- Public event discovery (proposed amendment to FR-M28-05) -------------------
# off (default): event pages stay unlisted. on: organizers may opt a live page into /jelajah.
EVENT_DISCOVERY=off
