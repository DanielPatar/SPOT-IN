# --- Environment -----------------------------------------------------------
# APP_ENV: development | test | demo | pilot. The demo clock (FR-M38-10) exists only in "demo".
APP_ENV=development
# Pilot mode must stay on for the whole MVP (FR-M38-*). The server refuses to start without it.
PILOT_MODE=on
APP_URL=http://localhost:3000
# 32+ random bytes, used to sign cookies and signed file URLs
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Database (PostgreSQL 16 + PostGIS + pg_trgm + btree_gist) --------------
DATABASE_URL=postgres://spotin@127.0.0.1:5433/spotin

# --- Email (FR-M21-01). EMAIL_DRIVER=outbox stores mail in the database (dev/test);
# smtp sends it through the transactional provider.
EMAIL_DRIVER=outbox
EMAIL_FROM="Spot-In <no-reply@spot-in.test>"
SMTP_URL=
ADMIN_EMAILS=admin@spot-in.test

# --- File storage: local (dev/test) or s3 --------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# --- Virus scanning: eicar (dev/test signature check) or clamd ---------------
SCANNER_DRIVER=eicar
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# --- Geocoding: nominatim or fake (tests) --------------------------------------
GEOCODER_DRIVER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="Spot-In course pilot (contact: team email)"
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="© OpenStreetMap contributors"

# --- Google sign-in (optional; leave blank to hide the button) -----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments (Build 2). Only test-mode keys are accepted (FR-M14-13). ----------
XENDIT_SECRET_KEY=
